# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel en dev : si renseigné, les slash commands sont déployées instantanément
# sur cette guild au lieu d'être déployées globalement (propagation ~1h).
DISCORD_GUILD_ID=

# --- Database ---
# SQLite : chemin de fichier local, aucun serveur à lancer.
DATABASE_URL="file:./dev.db"

# --- Environnement ---
# development | production
NODE_ENV=development

# --- Logging ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- AI (Phase 6) ---
# Optionnel : sans clé, /explainme répond en mode démonstration (StubProvider).
# Avec une clé, bascule automatiquement sur Anthropic (AnthropicProvider).
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
