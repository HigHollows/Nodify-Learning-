# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel en dev : si renseigné, les slash commands sont déployées instantanément
# sur cette guild au lieu d'être déployées globalement (propagation ~1h).
DISCORD_GUILD_ID=

# --- Database ---
# SQLite : chemin de fichier local, aucun serveur à lancer.
DATABASE_URL="file:./dev.db"

# --- Environnement ---
# development | production
NODE_ENV=development

# --- Logging ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- AI (Phase 6) ---
# Optionnel : sans clé, /explainme (et toutes les features IA) répondent en
# mode démonstration (StubProvider). Priorité si plusieurs clés présentes :
# Gemini > Anthropic > Groq > stub.

# Provider principal : https://aistudio.google.com/apikey
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Alternative rapide (modèles ouverts type Llama) : https://console.groq.com
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- AI Credit System ---
# Interrupteur maître : les crédits ne sont PAS une monnaie réelle, PAS
# achetables. À false, toutes les commandes IA fonctionnent sans vérifier
# ni consommer de crédits — aucune régression possible sur AIService.
CREDITS_ENABLED=true

DAILY_REWARD_ENABLED=true
DAILY_REWARD_AMOUNT=5
WEEKLY_REWARD_ENABLED=true
WEEKLY_REWARD_AMOUNT=100
MONTHLY_REWARD_ENABLED=true
MONTHLY_REWARD_AMOUNT=500
LEARNING_REWARDS_ENABLED=true

# Mode IA au tout premier démarrage — ensuite modifiable en live via /ai
# (open/close/maintenance/limited), persisté en base, survit aux redémarrages.
AI_DEFAULT_MODE=OPEN
AI_STATUS_ENABLED=true
AI_STATUS_AUTO_UPDATE=true
# Optionnel : rôle Discord mentionné sur une alerte "AI Incident" (dégradation
# ET retour à la normale), en plus du message posté dans le salon de statut.
# AI_INCIDENT_PING_ROLE_ID=

# Anti-abus — mettre à 0 pour désactiver une limite individuellement.
# Valeurs globales par défaut ; un serveur peut les surcharger via /ai budget.
MAX_AI_REQUESTS_PER_MINUTE=5
MAX_DAILY_AI_SPEND=100
MAX_MONTHLY_AI_SPEND=5000

# Délai avant qu'un appel IA soit considéré en timeout (remboursé, classifié
# TIMEOUT) — le provider peut continuer en arrière-plan, mais l'utilisateur
# n'attend jamais indéfiniment.
AI_REQUEST_TIMEOUT_MS=30000

# Multi-provider (optionnel) : force un provider précis pour une feature
# donnée, et/ou fait coûter plus cher les features tournant sur un provider
# plus cher. Sans ces variables, un seul provider (le prioritaire configuré)
# est utilisé pour tout, comme avant.
# AI_FEATURE_PROVIDER_OVERRIDES={"threatmodel":"anthropic"}
# AI_PROVIDER_COST_MULTIPLIERS={"anthropic":1.5}

# Bonus supporter (statut non-monétaire attribué par un admin via
# /credit-admin subscriber, jamais acheté) sur la récompense MONTHLY.
SUPPORTER_MONTHLY_BONUS_AMOUNT=200
