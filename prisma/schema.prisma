// Nodify — schéma Prisma
//
// Phase 1 : fondations multi-guild (Guild + config).
// Phase 3 : User Profile global (indépendant des guilds — un utilisateur a
// un seul profil, une seule progression, peu importe le serveur Discord
// depuis lequel il interagit).
// Les modèles Courses/Concepts/Documentation arriveront avec la Phase 4
// (Knowledge Engine) pour éviter de figer un schéma pas encore conçu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Un serveur Discord sur lequel Nodify est installé.
/// Nodify est multi-guild : chaque Guild a sa propre configuration.
model Guild {
  id        String   @id // Discord guild ID (snowflake), pas d'auto-increment
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config GuildConfig?

  @@map("guilds")
}

/// Configuration modulaire d'une guild (créée par /setup).
/// Un seul enregistrement par guild, en relation 1:1.
model GuildConfig {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // Modules activables indépendamment par serveur
  academyEnabled       Boolean @default(true)
  cyberEnabled         Boolean @default(true)
  newsEnabled          Boolean @default(true) // Hacktualités (Phase 9) — pas encore construit
  dailyQuestionEnabled Boolean @default(true)

  // Anti-doublon de la Question du jour : ne repostée qu'une fois par jour UTC,
  // et on évite de reposter deux fois la même question d'affilée.
  lastDailyQuestionDate String? // "YYYY-MM-DD"
  lastDailyQuestionKey  String?

  // Salons/rôles créés automatiquement par /setup, pour l'auto-recovery.
  // JSON object { [resourceKey]: snowflake } — la clé est l'identifiant stable
  // défini dans src/setup/resources.ts, ce qui permet de savoir exactement
  // quelle ressource Discord correspond à quelle définition entre deux /setup.
  managedChannelIds String @default("{}")
  managedRoleIds    String @default("{}")

  // Budgets IA par serveur (crédits) — `null` = pas d'override, on retombe
  // sur MAX_DAILY_AI_SPEND / MAX_MONTHLY_AI_SPEND (.env, global). Permet à
  // un serveur d'être plus restrictif (ou plus généreux) que le défaut
  // global sans toucher à la config du bot entier.
  maxDailyAiSpend   Int?
  maxMonthlyAiSpend Int?

  updatedAt DateTime @updatedAt

  @@map("guild_configs")
}

/// Profil utilisateur GLOBAL : un seul par personne Discord, partagé sur
/// tous les serveurs où Nodify est installé. La progression d'une personne
/// ne dépend pas du serveur qu'elle a rejoint.
model User {
  id       String @id // Discord user ID (snowflake)
  username String // dernier username connu, mis à jour à chaque interaction

  // XP global, gagnée uniquement en terminant de vraies leçons d'Academy
  // (Phase 5) — jamais fabriquée artificiellement.
  totalXp Int @default(0)

  // Streak : mesure réelle d'engagement (jours consécutifs avec au moins
  // une interaction Nodify), indépendante du contenu pédagogique.
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate String? // date UTC "YYYY-MM-DD" du dernier jour actif

  // Anti-doublon des DM automatiques (Phase 11) : "YYYY-MM-DD" du dernier
  // envoi, jamais deux fois le même jour même si le check périodique tourne
  // plusieurs fois — même pattern que GuildConfig.lastDailyQuestionDate.
  lastStreakReminderDate String?
  lastWeeklyRecapDate    String? // "YYYY-MM-DD" du lundi où le récap a été envoyé

  // Statut "supporter" non-monétaire (attribué par un admin, pas acheté —
  // les crédits ne sont pas une monnaie réelle) : donne un bonus sur la
  // récompense MONTHLY. Prépare une future vraie souscription sans
  // l'implémenter (aucun paiement ici).
  isSupporter Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills            UserSkill[]
  achievements      UserAchievement[]
  courseProgress    UserCourseProgress[]
  lessonCompletions UserLessonCompletion[]
  dailyAnswers      DailyQuestionAnswer[]
  ctfSolves         CtfSolve[]
  exerciseCompletions UserExerciseCompletion[]
  conceptViews        UserConceptView[]

  creditAccount      UserCreditAccount?
  creditTransactions CreditTransaction[]
  rewardClaims       RewardClaim[]
  aiCalls            AICall[]

  @@map("users")
}

/// Catalogue statique des compétences reconnues par Nodify.
/// Référentiel indépendant du contenu des cours — l'Academy (Phase 5) et
/// la Cyber Academy (Phase 8) s'y raccrocheront sans dupliquer cette liste.
///
/// `category` : SQLite ne supporte pas les enums natifs Prisma, donc stocké
/// en String et validé côté app via le type SkillCategory (src/types/skill.ts).
model Skill {
  id       String @id @default(cuid())
  key      String @unique // ex: "javascript", "linux" — stable, ne pas renommer
  name     String
  category String // "DEVELOPMENT" | "CYBERSECURITY" | "NETWORKING" | "AI" | "SYSTEMS" | "CLOUD"

  users UserSkill[]

  @@map("skills")
}

/// Progression d'un utilisateur sur une compétence précise.
/// Le niveau (Beginner..Expert) est dérivé de `xp`, pas stocké, pour ne
/// jamais désynchroniser la donnée brute et sa représentation.
model UserSkill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  xp        Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
  @@map("user_skills")
}

/// Catalogue statique des succès débloquables.
model Achievement {
  id          String @id @default(cuid())
  key         String @unique // ex: "welcome" — stable, ne pas renommer
  name        String
  description String
  icon        String // emoji

  users UserAchievement[]

  @@map("achievements")
}

/// Succès effectivement débloqué par un utilisateur.
model UserAchievement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

/// Knowledge Engine (Phase 4) : unité de connaissance partagée par le
/// dictionnaire, /explainme (Phase 6), les cours (Phase 5) et la doc (Phase 6).
/// Un seul modèle de concept pour toutes ces features, pas cinq systèmes
/// séparés qui stockeraient la même information.
///
/// `relatedKeys` / `prerequisiteKeys` : listes de `Concept.key`, en JSON —
/// même pattern que GuildConfig.managedRoleIds. Pas de table de graphe
/// relationnelle tant que le nombre de concepts reste petit ; à migrer si
/// on a un jour besoin de vraies requêtes de graphe (ex: "qui dépend de X").
model Concept {
  id   String @id @default(cuid())
  key  String @unique // slug stable, ex: "jwt", "promise" — ne pas renommer
  name String

  category String // même taxonomie que Skill.category (src/types/skill.ts)
  level    Int // 1 (Beginner) à 5 (Expert), voir LEVEL_ROLES

  definition           String // définition courte, affichée par défaut
  explanationBeginner  String
  explanationAdvanced  String
  docUrl               String? // lien vers une doc officielle, si pertinent

  relatedKeys      String @default("[]")
  prerequisiteKeys String @default("[]")

  aliases ConceptAlias[]
  views   UserConceptView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("concepts")
}

/// Synonymes/abréviations pointant vers un concept (ex: "JS" → "javascript").
/// `term` est stocké en minuscules pour une recherche insensible à la casse.
model ConceptAlias {
  id        String  @id @default(cuid())
  term      String  @unique
  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@map("concept_aliases")
}

/// Academy (Phase 5) : un cours = un parcours linéaire de leçons sur une
/// compétence précise (`skillKey` pointe vers Skill.key). Terminer un cours
/// est la SEULE vraie source d'XP dans Nodify.
///
/// `prerequisiteCourseKeys` existe déjà pour permettre de bloquer un cours
/// tant qu'un autre n'est pas terminé, mais n'est pas encore appliqué : avec
/// un seul cours au lancement, il n'y a rien à bloquer. Le champ est prêt
/// pour quand il y aura plusieurs cours à enchaîner.
model Course {
  id          String @id @default(cuid())
  key         String @unique // slug stable, ex: "js-intro"
  title       String
  description String
  category    String // même taxonomie que Skill.category
  skillKey    String // Skill.key crédité en XP à la complétion des leçons
  level       Int // 1 (Beginner) à 5 (Expert)

  prerequisiteCourseKeys String @default("[]") // JSON array de Course.key — pas encore appliqué

  lessons  Lesson[]
  progress UserCourseProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

/// Une leçon = du contenu pédagogique + un quiz de validation.
/// `order` définit la progression linéaire au sein du cours (1, 2, 3...).
model Lesson {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  order     Int
  title     String
  content   String // texte pédagogique de la leçon
  xpReward  Int    @default(20)

  questions   Question[]
  completions UserLessonCompletion[]

  @@unique([courseId, order])
  @@map("lessons")
}

/// Question à choix multiples de validation d'une leçon.
/// `choices` : JSON array de strings. `correctIndex` : index (0-based) de
/// la bonne réponse dans `choices`.
model Question {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  order        Int
  prompt       String
  choices      String // JSON array de strings
  correctIndex Int
  explanation  String // affichée après réponse, bonne ou mauvaise — renforce l'apprentissage

  @@unique([lessonId, order])
  @@map("questions")
}

/// Progression d'un utilisateur sur un cours entier.
/// `currentLessonOrder` = prochaine leçon à faire (pas encore complétée).
model UserCourseProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status             String    @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"
  currentLessonOrder Int       @default(1)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@unique([userId, courseId])
  @@map("user_course_progress")
}

/// Résultat d'une leçon terminée par un utilisateur (score au quiz).
/// Ré-écrasé si la leçon est refaite (une seule ligne par (user, lesson) —
/// on garde le dernier essai, pas l'historique complet des tentatives).
model UserLessonCompletion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  score          Int
  totalQuestions Int
  passed         Boolean
  completedAt    DateTime @default(now())

  @@unique([userId, lessonId])
  @@map("user_lesson_completions")
}

/// Documentation RAG (Phase 6) — un chunk = un extrait ciblé et autonome
/// d'une documentation technique, rédigé à la main (pas de contenu copié
/// depuis un site tiers).
///
/// Retrieval par mots-clés (pas d'embeddings) : Anthropic n'expose pas
/// d'API d'embeddings publique, donc pas de vraie recherche vectorielle
/// pour l'instant — voir src/documentation/docsService.ts pour le détail
/// de ce choix et comment migrer si un provider d'embeddings est ajouté.
model DocChunk {
  id      String @id @default(cuid())
  source  String // ex: "Node.js", "Discord.js", "PostgreSQL", "OWASP"
  title   String
  url     String
  content String

  createdAt DateTime @default(now())

  @@unique([source, title])
  @@map("doc_chunks")
}

/// Catalogue statique de questions pour la Question du jour — rédigées à la
/// main, pas de contenu inventé à la volée par IA (évite les questions
/// factuellement fausses générées automatiquement).
model DailyQuestion {
  id           String @id @default(cuid())
  key          String @unique
  category     String // même taxonomie que Skill.category
  prompt       String
  choices      String // JSON array de strings
  correctIndex Int
  explanation  String

  createdAt DateTime @default(now())

  @@map("daily_questions")
}

/// Une réponse d'utilisateur à LA question du jour d'une guild donnée.
/// Contrainte unique (userId, guildId, date) : empêche de répondre deux
/// fois au même jour sur le même serveur, que ce soit via le post
/// automatique ou via /daily.
model DailyQuestionAnswer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guildId String
  date    String // "YYYY-MM-DD" UTC
  correct Boolean

  // Dénormalisé depuis DailyQuestion.category au moment de la réponse
  // (Phase 11) — permet une analyse "points faibles" par catégorie sans
  // avoir besoin de retrouver la question d'origine (qui peut changer de
  // contenu au fil du temps). Nullable : les réponses données avant cet
  // ajout n'ont pas cette info, exclues proprement (pas de faux 0) des
  // agrégations qui en dépendent.
  category String?

  answeredAt DateTime @default(now())

  @@unique([userId, guildId, date])
  @@map("daily_question_answers")
}

/// Consultation d'un concept du dictionnaire (Phase 11) — alimente la
/// révision espacée (`/review`) : un concept vu il y a longtemps et jamais
/// revu depuis est un bon candidat à reproposer. Une ligne par (user,
/// concept), mise à jour (pas dupliquée) à chaque nouvelle consultation.
model UserConceptView {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  viewedAt DateTime @updatedAt // dernière consultation — pas la première

  @@unique([userId, conceptId])
  @@map("user_concept_views")
}

/// CTF (Phase 8) — défis AUTONOMES rédigés à la main, résolubles sans cible
/// en direct (crypto/forensics/OSINT). Volontairement pas de catégories
/// Web/Pwn/Network/Reverse qui nécessiteraient une vraie infrastructure de
/// sandbox — ce serait fabriquer une fausse capacité.
///
/// `acceptedAnswers` : JSON array de réponses valides normalisées (voir
/// src/cybersecurity/ctfService.ts) — permet d'accepter plusieurs formulations
/// correctes (ex: "IOC" et "indicateur de compromission") sans dupliquer le défi.
model CtfChallenge {
  id          String @id @default(cuid())
  key         String @unique
  category    String // "CRYPTO" | "FORENSICS" | "OSINT" (extensible)
  difficulty  Int // 1 (Beginner) à 5 (Expert), voir LEVEL_ROLES
  title       String
  description String
  hint        String?
  points      Int

  acceptedAnswers String // JSON array de strings

  createdAt DateTime @default(now())
  solves    CtfSolve[]

  @@map("ctf_challenges")
}

/// Résolution d'un défi CTF par un utilisateur. Contrainte unique : un défi
/// ne rapporte ses points qu'une seule fois par utilisateur.
model CtfSolve {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  challengeId String
  challenge   CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  solvedAt DateTime @default(now())

  @@unique([userId, challengeId])
  @@map("ctf_solves")
}

/// Exercices pratiques (Phase 10) — courts, ciblés, complémentaires aux
/// cours Academy (progression linéaire longue) et au CTF (défis autonomes
/// thématiques). Deux formats couvrent les types du spec sans exploser la
/// complexité : "MCQ" (QCM classique, `choices`+`correctIndex`) et "TEXT"
/// (Debug/Trouve le bug/Complète le code — réponse courte comparée à
/// `acceptedAnswers`, même pattern de normalisation que CtfChallenge).
/// "Explique ce code"/"Analyse sécurité"/"Architecture review" restent
/// servis par les outils IA existants (/explainme, /securityreview,
/// /codereview) — un format libre évalué par IA, pas un exercice à
/// réponse unique comme ceux-ci.
model Exercise {
  id         String @id @default(cuid())
  key        String @unique
  type       String // "MCQ" | "TEXT"
  category   String // même taxonomie que Skill.category
  difficulty Int // 1 (Beginner) à 5 (Expert), voir LEVEL_ROLES
  title      String
  prompt     String // énoncé, souvent avec un extrait de code en Markdown

  choices      String? // JSON array de strings — uniquement type "MCQ"
  correctIndex Int? // uniquement type "MCQ"

  acceptedAnswers String? // JSON array de strings normalisées — uniquement type "TEXT"

  explanation String
  xpReward    Int    @default(10)
  skillKey    String? // Skill.key crédité en XP à la résolution, si pertinent

  createdAt   DateTime @default(now())
  completions UserExerciseCompletion[]

  @@map("exercises")
}

/// Résolution d'un exercice par un utilisateur. Contrainte unique : ne
/// rapporte sa récompense qu'une seule fois par utilisateur (rejouable
/// pour s'entraîner, mais pas pour refarmer XP/crédits).
model UserExerciseCompletion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  solvedAt DateTime @default(now())

  @@unique([userId, exerciseId])
  @@map("user_exercise_completions")
}

/// Hacktualités (Phase 9) — jamais d'actualité inventée : uniquement des
/// articles réels récupérés depuis de vrais flux RSS de sources officielles
/// (voir src/community/newsService.ts pour la liste des flux).
/// Un seul enregistrement par article déjà diffusé (guid du flux RSS), pour
/// ne jamais reposter deux fois le même article sur l'ensemble des guildes.
model PostedNewsArticle {
  id       String   @id @default(cuid())
  guid     String   @unique
  source   String
  title    String
  url      String
  postedAt DateTime @default(now())

  @@map("posted_news_articles")
}

// ============================================================================
// AI Credit System & AI Control Center
//
// Les crédits ne sont PAS une monnaie réelle et ne sont PAS achetables.
// Rôle : contrôler les coûts IA, éviter les abus, récompenser
// l'apprentissage réel. Tout le système reste désactivable via
// CREDITS_ENABLED=false (voir src/credits/), sans casser AIService.
// ============================================================================

/// Portefeuille de crédits d'un utilisateur — 1:1 avec User, créé à la
/// demande (getOrCreateAccount), jamais négatif par construction (voir
/// creditRepository.spendCredits : update atomique conditionné sur le solde).
model UserCreditAccount {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance       Int @default(0)
  totalEarned   Int @default(0)
  totalSpent    Int @default(0)
  totalRefunded Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_credit_accounts")
}

/// Historique complet des mouvements de crédits — jamais de modification
/// silencieuse du solde sans une ligne ici. `status` porte le cycle de
/// réservation (RESERVED → COMPLETED | REFUNDED | FAILED) utilisé pour les
/// dépenses IA : réserver avant l'appel, confirmer ou rembourser après.
model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guildId String? // pertinent si l'action a eu lieu dans le contexte d'une guild

  amount Int // positif (EARN/REFUND/BONUS/ADMIN_GRANT...) ou négatif (SPEND/ADMIN_REMOVE)
  type   String // EARN | SPEND | REFUND | BONUS | ADMIN_GRANT | ADMIN_REMOVE | DAILY | WEEKLY | MONTHLY | LEARNING_REWARD | ACHIEVEMENT | SYSTEM_ADJUSTMENT
  status String @default("COMPLETED") // RESERVED | COMPLETED | REFUNDED | FAILED

  reason  String // description lisible (ex: "Récompense quotidienne", "Participation au CTF")
  feature String? // clé de la fonctionnalité IA concernée (ex: "explainme"), si pertinent

  metadata String? // JSON libre (ex: { adminId, tokensUsed... }), optionnel

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("credit_transactions")
}

/// Un enregistrement par claim de récompense périodique (daily/weekly/monthly).
/// Le cooldown est vérifié côté serveur via `nextAvailableAt`, jamais côté
/// Discord seul — voir src/credits/rewardService.ts.
model RewardClaim {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rewardType String // DAILY | WEEKLY | MONTHLY
  amount     Int
  claimedAt  DateTime @default(now())
  nextAvailableAt DateTime

  @@index([userId, rewardType])
  @@map("reward_claims")
}

/// Journal de chaque appel au provider IA — sert à la fois d'audit et de
/// base pour les statistiques admin (/ai stats, /ai usage). Le tracking de
/// tokens est prévu (nullable) pour une évolution future vers un coût basé
/// sur l'usage réel, sans devoir changer le schéma.
model AICall {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  guildId String?

  feature  String // ex: "explainme", "securityreview"
  provider String // ex: "gemini", "anthropic", "groq", "stub"
  model    String?

  status     String // SUCCESS | ERROR | TIMEOUT
  creditCost Int
  refunded   Boolean @default(false)

  tokensInput  Int?
  tokensOutput Int?
  latencyMs    Int?

  errorMessage String? // jamais de secret/donnée sensible ici

  createdAt DateTime @default(now())

  @@index([feature])
  @@index([createdAt])
  @@map("ai_calls")
}

/// Configuration système dynamique modifiable depuis Discord (contrairement
/// aux secrets et interrupteurs maîtres, qui restent en .env — voir
/// src/config/env.ts). Singleton : une seule ligne, id fixe "singleton".
model SystemConfig {
  id String @id @default("singleton")

  // Intention admin (via /ai open|close|maintenance|limited) — persiste au
  // redémarrage, contrairement à un simple flag .env qu'il faudrait éditer
  // et redéployer pour changer.
  aiMode            String    @default("OPEN") // OPEN | LIMITED | MAINTENANCE | CLOSED
  maintenanceReason String?
  maintenanceSince  DateTime?

  // Panneau de statut IA persistant (voir src/credits/statusPanelService.ts)
  statusChannelId String?
  statusMessageId String?

  // Télémétrie pour calculer le statut affiché (DEGRADED/ERROR/QUOTA...)
  lastSuccessfulRequestAt DateTime?
  lastErrorAt             DateTime?
  lastErrorMessage        String?
  // Classification structurée de la dernière erreur (QUOTA/TIMEOUT/NETWORK/
  // INVALID_KEY/PROVIDER_ERROR) — computeAiStatus() s'appuie dessus plutôt
  // que de deviner en cherchant "quota" dans lastErrorMessage.
  lastErrorCode String?

  // Dernier statut pour lequel une alerte "AI Incident" a été postée (voir
  // statusPanelService.ts) — évite de spammer le salon à chaque refresh
  // tant que le statut n'a pas réellement changé.
  lastNotifiedStatus String?

  updatedAt DateTime @updatedAt

  @@map("system_config")
}

/// Journal d'audit des actions administratives (AI Control Center + Credit
/// Admin Grants) — jamais d'action admin sensible sans trace.
model AdminAuditLog {
  id      String @id @default(cuid())
  adminId String
  action  String // ex: "AI_CLOSED", "AI_OPENED", "CREDITS_GRANTED"...

  targetUserId String?
  reason       String?
  metadata     String? // JSON libre

  createdAt DateTime @default(now())

  @@map("admin_audit_logs")
}
